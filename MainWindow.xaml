<Window x:Class="Memoriajatek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Memoriajatek"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ListBox x:Name="lb_palyameret" SelectionChanged="kivalasztott_meret" Grid.Row="0" Grid.Column="0"/>
        <ListBox x:Name="lb_tipus" Grid.Row="0"  Grid.Column="1" SelectionChanged="kivalasztott_tipus" />
        <Button x:Name="btn_kezdes" Content="Kezdés" HorizontalAlignment="Center" VerticalAlignment="Center" Height="23" Width="74" RenderTransformOrigin="1.222,0.779" Click="btn_kezdes_Click" Grid.Row="1"/>
        <Grid x:Name="jatekter" Grid.Row="1" Grid.Column="1" />
    </Grid>
</Window>
